<header class="sheet-header flexrow" id="sheet-header">
  <img
    class="profile-img"
    src="{{item.img}}"
    alt="{{item.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{item.name}}"
    height="100" width="100"
  >
	<div class="details flexcolumn">
	  {{formGroup itemFields.name value=item.name}}
	
		<div class="subDetails flexrow">
			{{formGroup systemFields.details.fields.manufacturer value=system.details.manufacturer localize=true hint=false}}
			{{formGroup systemFields.details.fields.introductionYear value=system.details.introductionYear localize=true hint=false}}
			{{formGroup systemFields.details.fields.origin value=system.details.origin localize=true hint=false}}
		</div>
		<div class="subDetails flexrow">
			{{formGroup systemFields.details.fields.costUnit value=system.details.costUnit localize=true hint=false}}
			{{formGroup systemFields.details.fields.costBulk value=system.details.costBulk localize=true hint=false}}
		</div>
	</div>
</header>

