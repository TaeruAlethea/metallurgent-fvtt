<header class="sheet-header flexrow">
  <img
    class="profile-img"
    src="{{item.img}}"
    alt="{{item.name}}"
    {{#if editable}}
    data-action="editImage"
    data-edit="img"
    {{/if}}
    data-tooltip="{{item.name}}"
    height="100" width="100"
  >
	<div class="flexcolumn">
	  {{formInput itemFields.name value=item.name}}
	
		<div class="flexrow">
		  {{#each systemFields.details.fields}}
				{{#unless (equals this.name "description") }}
					{{formGroup this value=value localize=true}}
				{{/unless}}
			{{/each}}
		</div>
	</div>
</header>
