<section
  class="standard-form tab scrollable {{tab.cssClass}}"
  data-group="primary"
  data-tab="fireControlAttributes"
>
  <div class="flexcolumn">
    {{formGroup systemFields.enDrain value=system.enDrain localize=true}}
    {{formGroup systemFields.rangeInner value=system.rangeInner localize=true}}
    {{formGroup systemFields.rangeOuter value=system.rangeOuter localize=true}}
    {{formGroup systemFields.targetingType value=system.targetType
    localize=true}}
  </div>
</section>
