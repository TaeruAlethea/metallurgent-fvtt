<section
  class="standard-form tab scrollable {{tab.cssClass}}"
  data-group="primary"
  data-tab="componentAttributes"
>
  <div class="flexcolumn">
    {{formGroup systemFields.enOutput value=system.enOutput localize=true}}
    {{formGroup systemFields.enCapacity value=system.enCapacity localize=true}}
    {{formGroup systemFields.fuelCapacity value=system.fuelCapacity
    localize=true}} {{formGroup systemFields.chargeCapacity
    value=system.chargeCapacity localize=true}} {{formGroup
    systemFields.heatTolerance value=system.heatTolerance localize=true}}
    {{formGroup systemFields.coolingType value=system.coolingType
    localize=true}}
  </div>
</section>
