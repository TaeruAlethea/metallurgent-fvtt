<section
  class="standard-form tab scrollable {{tab.cssClass}}"
  data-group="primary"
  data-tab="componentAttributes"
>
  <div class="flexcolumn">
    {{formGroup systemFields.blockBonus value=system.blockBonus localize=true}}
    {{formGroup systemFields.blockCost value=system.blockCost localize=true}}
    {{formGroup systemFields.defenceValue value=system.defenceValue
    localize=true}} {{formGroup systemFields.criticalOutput
    value=system.CriticalOutput localize=true}} {{formGroup
    systemFields.hardpoints value=system.hardpoints localize=true}}
  </div>
</section>
